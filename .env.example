# Copy to .env and fill in. .env is git-ignored.

# Fing → Agent Settings → Local API → API key (or an op://vault/item/field reference)
FING_API_KEY=your-fing-api-key-here

# Where the Fing agent's Local API listens (port 49090; a trailing /1 is optional).
# Leave unset for the right default: http://localhost:49090 when run directly, or
# http://host.docker.internal:49090 (the Docker host) under docker compose.
# Set it for a Fingbox / Fing Agent or Fing on another machine:
# FING_API_BASE_URL=http://192.168.x.x:49090

# FING_TIMEOUT=10
# FING_RETRIES=2
# FING_AGENT_INFO_PORT=44444

# MCP transport: stdio (default, for VS Code / Claude Desktop) or http
# MCP_TRANSPORT=stdio
# MCP_HOST=127.0.0.1
# MCP_PORT=8000

# docker compose only: host interface/port to publish on (loopback by default; endpoint is unauthenticated)
# MCP_BIND=127.0.0.1
# MCP_PUBLISH_PORT=8000

# Optional 1Password Connect for op:// references (token must be a literal value)
# OP_CONNECT_HOST=http://op-connect-api:8080
# OP_CONNECT_TOKEN=
